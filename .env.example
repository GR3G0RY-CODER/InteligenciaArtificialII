# Supabase project API (server-only service role)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Public base URL used by payment redirects
APP_URL=http://localhost:3000
# Stripe server keys and webhook signing secret
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
# Initial owner seed (used by npm run db:seed)
SEED_OWNER_EMAIL=admin@gymflow.com
SEED_OWNER_PASSWORD=change-this-strong-password
SEED_TENANT_NAME=Academia Performance

# Demo cloud-only. Keep false in production.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
# Required only when DEMO_MODE=true; generate with: openssl rand -base64 48
DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters
